{
  "name": "castle-bank-bot",
  "version": "1.0.0",
  "description": "Discord bot for Castle's Guild Bank (an EverQuest guild).",
  "main": "src/index.ts",
  "repository": "git@github.com:sgoodrow/castle.git",
  "author": "Scott Goodrow <sgoodrow@gmail.com>",
  "license": "MIT",
  "scripts": {
    "clean": "docker-compose down && rimraf postgres-db",
    "start": "tsc && nodemon",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/web && npm --prefix bank/web run lint",
    "build": "tsc --skipLibCheck && yarn build:bank",
    "build:bank": "cd bank/web && npm ci --include=dev && npm run build && rm -rf node_modules",
    "predev": "docker-compose up -d --wait",
    "dev": "nodemon",
    "test": "vitest",
    "test:ci": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google-cloud/local-auth": "^2.1.0",
    "@prisma/client": "^5.1.0",
    "@types/moment-timezone": "^0.5.30",
    "@types/pg": "^8.6.5",
    "async-mutex": "^0.4.0",
    "axios": "^1.3.4",
    "axios-retry": "^3.4.0",
    "chrono-node": "^2.9.1",
    "discord.js": "^14.25.1",
    "ffmpeg-static": "^5.3.0",
    "google-spreadsheet": "^3.3.0",
    "googleapis": "^105.0.0",
    "libsodium-wrappers": "^0.7.15",
    "lodash": "^4.17.21",
    "lru-cache": "^7.17.0",
    "mediaplex": "^1.0.0",
    "moment": "^2.29.2",
    "moment-timezone": "^0.5.34",
    "pg": "^8.7.3",
    "prisma": "^5.2.0",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^3.0.2",
    "source-map": "0.6.1",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.6",
    "xlsx": "^0.18.5",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@cucumber/gherkin": "29.0.0",
    "@cucumber/messages": "24.1.0",
    "@swc/core": "1.7.26",
    "@types/google-spreadsheet": "^3.3.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22",
    "@types/node-fetch": "^2.6.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "nodemon": "^2.0.15",
    "prettier": "^3.9.10",
    "ts-node": "^10.7.0",
    "typescript": "5.7",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.9"
  }
}
