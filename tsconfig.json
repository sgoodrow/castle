{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "isolatedModules": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "types": ["jest", "node"]
  },
  "exclude": ["./node_modules", "**/*.test.ts", "src/web/features", "./bank"]
}
